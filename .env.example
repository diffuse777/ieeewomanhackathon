# Server
NODE_ENV=development
PORT=5000

# Required — this app stores data ONLY in hackathon_registration.
# Any other database name in the URI is rewritten; any other MONGODB_DB_NAME is rejected.
# Example: mongodb+srv://USER:PASS@cluster.mongodb.net/hackathon_registration?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=hackathon_registration
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional on Vercel — set a long fixed JWT_SECRET so redeploys do not invalidate admin logins
# JWT_SECRET=
# CLIENT_URL=
# PAYMENT_WEBHOOK_SECRET=

# Payment gateway (optional). Defaults to mock if omitted.
# PAYMENT_PROVIDER=mock | razorpay
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
